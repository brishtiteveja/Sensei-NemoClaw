# Runtime state, not source.
# model_choice.json is whatever was last picked in Settings; the translation cache
# is regenerable (though worth backing up before a demo, since a cold cache makes
# the first load in each language slow).
data/model_choice.json
data/translations/

# Student data. Never in version control: learner profiles carry names, exam
# dates and specific mistakes, and the observation logs are a stroke-by-stroke
# record of a child's working. This repo is public.
data/learners.db
data/learners.db-journal
data/observations/
data/custom_questions.json
